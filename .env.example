# Variables que necesita /api/leads para no perder solicitudes de asesoría.
# Copiar a .env.local para desarrollo y configurarlas en Vercel para producción.
#
# Sin ninguna de estas variables, en desarrollo el lead se imprime en consola y
# el formulario responde correctamente. En producción, en cambio, la ruta
# devuelve error a propósito para que el usuario vea las vías alternativas de
# contacto en vez de creer que su solicitud quedó guardada.

# --- Base de datos (Neon) — OBLIGATORIA ---------------------------------
# Es el único destino que hoy decide si un lead se guarda o se pierde.
# Cadena de conexión de Neon, desde el Vercel Marketplace o console.neon.tech.
# Antes del primer despliegue hay que ejecutar db/001_leads.sql una sola vez.
DATABASE_URL="postgresql://usuario:contrasena@host.neon.tech/econoluz?sslmode=require"

# --- Rol de lectura pública — OBLIGATORIA en producción ------------------
# Cadena del rol `econoluz_publico`, que SOLO puede leer `public_products`.
# Su contraseña se genera fuera del repositorio; ver docs/OPERACION-ROL-PUBLICO.md.
# Si falta en producción, el catálogo se sirve del respaldo estático y se
# registra un error de configuración. NUNCA se usa DATABASE_URL en su lugar:
# ese respaldo quitaría la barrera sin que nadie se entere.
# El lector `relational_v2` exige siempre esta cadena y nunca sustituye el rol
# público por DATABASE_URL. La tolerancia local de app/data/origenPublico.ts se
# conserva únicamente para caminos anteriores que aún la consuman.
DATABASE_URL_PUBLIC=

# Segunda llave de la Fase D. Permanece cerrada: preparar y probar el lector no
# autoriza a servirlo. Solo la cadena exacta "true" permitiría la activación.
FASE_D_AUTORIZADA=false

# --- Identidad de clientes (Firebase) — OBLIGATORIAS para /cuenta --------
# NO hay clave privada de cuenta de servicio: la organización las prohíbe por
# política. El servidor usa credenciales predeterminadas de la aplicación:
#   - en local, `gcloud auth application-default login`, fuera del repositorio;
#   - en producción, una identidad federada que TODAVÍA NO EXISTE y bloquea el
#     despliegue. Ver docs/OPERACION-FIREBASE.md §3.
FIREBASE_PROJECT_ID=

# Configuración pública del SDK web. Llega al navegador a propósito y no es
# secreta; sin ella, /cuenta/entrar no puede autenticar.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Pimienta para el HMAC de la IP en auth_events. Nunca se guarda la IP en claro.
# Generar fuera del repositorio con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si rota, las huellas anteriores dejan de ser comparables con las nuevas.
#
# OBLIGATORIA EN PRODUCCIÓN. Sin ella no hay huella, sin huella no se pueden contar
# los intentos fallidos y no habría ningún límite de fuerza bruta. Antes eso se
# resolvía dejando pasar, en silencio; ahora, en producción, el intento se RECHAZA y
# queda un error en el log. Un despliegue sin esta variable deja el acceso de clientes
# cerrado —molesto y evidente— en lugar de abierto y desprotegido.
# En desarrollo local sí se permite entrar sin ella, con un aviso.
AUTH_EVENT_IP_PEPPER=

# --- Notificación por correo (Resend) — OPCIONAL, HOY PENDIENTE ---------
# Las tres variables de abajo están sin definir a propósito: el dominio del
# correo corporativo lo controla un tercero y no se puede verificar el
# remitente en Resend. Mientras falte cualquiera de las tres, el envío se
# omite, queda constancia en el log y el lead se guarda igual en la base de
# datos; el usuario ve la confirmación normal, no un error.
# Al recuperar el control del dominio basta con rellenarlas: no hay que
# tocar código. Mientras tanto, los leads se consultan en la tabla `leads`.
#
# Clave de API de resend.com. El dominio del remitente debe estar verificado
# allí con sus registros DNS, o los correos no salen.
RESEND_API_KEY=""

# Remitente verificado en Resend. No puede ser un buzón cualquiera.
LEADS_EMAIL_FROM="ECONOLUZ GT <no-reply@econoluz.net>"

# Destinatarios de los avisos. Admite varios separados por coma.
LEADS_EMAIL_TO="ventas@econoluz.net"

# --- Panel de administración — OBLIGATORIA para /admin -------------------
# Con este secreto se calcula la huella HMAC-SHA-256 que se guarda en la tabla
# `admin_sessions`: la base de datos nunca ve el token que lleva el navegador,
# así que quien lea la tabla no puede suplantar a nadie.
# Sin esta variable el panel no arranca, a propósito: con un valor por defecto
# las huellas serían predecibles y todo parecería funcionar igual.
# Hay que definirla en .env.local y en Vercel, y generarla así:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Cambiarla cierra de golpe todas las sesiones abiertas.
ADMIN_SESSION_SECRET=""

# --- Fotos del panel (Vercel Blob) — OBLIGATORIA para subir imágenes -----
# Las fotos que se suben desde el panel no van al repositorio: van al almacén
# Blob del proyecto en Vercel. Se crea en vercel.com → proyecto → Storage →
# Blob, con acceso **Public** (son fotos de catálogo, las ve cualquier
# visitante) y marcando la casilla que genera el token de lectura y escritura.
# El valor se copia desde ahí a .env.local; en Vercel ya queda puesto solo.
# Sin esta variable el panel deja editar productos, pero no subir fotos nuevas.
BLOB_READ_WRITE_TOKEN=""

# --- Pruebas E2E de clientes — solo desarrollo ---------------------------
# Las pruebas de Playwright que necesitan un cliente con sesión se autentican
# de verdad: piden un ID token al emulador de Firebase Authentication y lo
# canjean por `POST /api/clientes/sesion`, la misma frontera que usa el
# navegador. No hay atajo, y si falta cualquiera de estas variables la suite
# falla de forma explícita en vez de degradar a una cookie fabricada.
#
# El emulador se levanta en otra consola:
#   npx firebase-tools emulators:start --only auth --project econoluz-dev-d30ab
# Ver docs/OPERACION-FIREBASE.md §6.

# Host y puerto del emulador. Lo lee `firebase-admin` y también el servidor de
# desarrollo que levanta Playwright.
FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"

# Clave de API que acepta la REST del emulador. Con el emulador vale cualquier
# cadena no vacía; se declara para no esconder el requisito el día que se
# apunte a un proyecto real.
E2E_FIREBASE_API_KEY="clave-de-emulador-e2e"

# Nombre sellado de la rama de Neon contra la que corren las E2E, el mismo que
# guarda `app_settings.rama_neon`. Es la comprobación POSITIVA de contra qué
# base se está trabajando: «no es Producción» no basta, porque estas pruebas
# escriben de verdad. Se sella con:
#   node scripts/guarda-neon.mjs --sellar <rama>
NEON_RAMA_E2E=""
