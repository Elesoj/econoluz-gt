# Variables que necesita /api/leads para no perder solicitudes de asesoría.
# Copiar a .env.local para desarrollo y configurarlas en Vercel para producción.
#
# Sin ninguna de estas variables, en desarrollo el lead se imprime en consola y
# el formulario responde correctamente. En producción, en cambio, la ruta
# devuelve error a propósito para que el usuario vea las vías alternativas de
# contacto en vez de creer que su solicitud quedó guardada.

# --- Base de datos (Neon) — OBLIGATORIA ---------------------------------
# Es el único destino que hoy decide si un lead se guarda o se pierde.
# Cadena de conexión de Neon, desde el Vercel Marketplace o console.neon.tech.
# Antes del primer despliegue hay que ejecutar db/001_leads.sql una sola vez.
DATABASE_URL="postgresql://usuario:contrasena@host.neon.tech/econoluz?sslmode=require"

# --- Notificación por correo (Resend) — OPCIONAL, HOY PENDIENTE ---------
# Las tres variables de abajo están sin definir a propósito: el dominio del
# correo corporativo lo controla un tercero y no se puede verificar el
# remitente en Resend. Mientras falte cualquiera de las tres, el envío se
# omite, queda constancia en el log y el lead se guarda igual en la base de
# datos; el usuario ve la confirmación normal, no un error.
# Al recuperar el control del dominio basta con rellenarlas: no hay que
# tocar código. Mientras tanto, los leads se consultan en la tabla `leads`.
#
# Clave de API de resend.com. El dominio del remitente debe estar verificado
# allí con sus registros DNS, o los correos no salen.
RESEND_API_KEY=""

# Remitente verificado en Resend. No puede ser un buzón cualquiera.
LEADS_EMAIL_FROM="ECONOLUZ GT <no-reply@econoluz.net>"

# Destinatarios de los avisos. Admite varios separados por coma.
LEADS_EMAIL_TO="ventas@econoluz.net"

# --- Panel de administración — OBLIGATORIA para /admin -------------------
# Con este secreto se calcula la huella HMAC-SHA-256 que se guarda en la tabla
# `admin_sessions`: la base de datos nunca ve el token que lleva el navegador,
# así que quien lea la tabla no puede suplantar a nadie.
# Sin esta variable el panel no arranca, a propósito: con un valor por defecto
# las huellas serían predecibles y todo parecería funcionar igual.
# Hay que definirla en .env.local y en Vercel, y generarla así:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Cambiarla cierra de golpe todas las sesiones abiertas.
ADMIN_SESSION_SECRET=""
